# Anthropic API key voor AI-mailgeneratie én het parsen van leveranciersreplies
# (model: claude-sonnet-4-6). Kopieer dit bestand naar .env en vul je sleutel in.
ANTHROPIC_API_KEY=

# --- E-maildemo (Gmail SMTP) ---
# Verzending gaat via smtp.gmail.com:587 (STARTTLS). Zonder GMAIL_USER /
# GMAIL_APP_PASSWORD wordt de verzending gesimuleerd zodat de demo altijd werkt.
#
# GMAIL_APP_PASSWORD is een Gmail *app-wachtwoord* (16 tekens), NIET je gewone
# wachtwoord. Aanmaken: Google-account > Beveiliging > 2-staps­verificatie >
# App-wachtwoorden.
GMAIL_USER=jouw.adres@gmail.com
GMAIL_APP_PASSWORD=

# Weergavenaam van de afzender (optioneel).
MAIL_FROM_NAAM=PowerCompliance

# Demo-ontvanger: als dit is ingesteld gaan ALLE demo-e-mails naar dit adres
# (i.p.v. het echte leveranciersadres). Optioneel.
DEMO_EMAIL=
