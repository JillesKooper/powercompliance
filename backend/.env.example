# Anthropic API key voor AI-mailgeneratie én het parsen van leveranciersreplies
# (model: claude-sonnet-4-6). Kopieer dit bestand naar .env en vul je sleutel in.
ANTHROPIC_API_KEY=

# --- E-maildemo (SendGrid) ---
# API-sleutel van SendGrid (gratis tier). Zonder sleutel wordt de verzending
# gesimuleerd zodat de demo altijd werkt.
SENDGRID_API_KEY=

# Afzender (moet een in SendGrid geverifieerd afzenderadres zijn).
MAIL_FROM=compliance@powercompliance.nl
MAIL_FROM_NAAM=PowerCompliance

# Demo-ontvanger: ALLE dataverzoek-e-mails worden tijdens de demo naar dit
# adres gestuurd (i.p.v. het echte leveranciersadres).
DEMO_EMAIL=
